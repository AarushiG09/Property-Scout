# Property Scout - Environment Configuration

# 1. LLM Orchestration (Gemini 3.6 Flash)
# Required for conversational agent, intent parsing, and explanations
GEMINI_API_KEY=your_gemini_api_key_here

# 2. OpenStreetMap MCP Server
OSM_MCP_URL=http://localhost:3001/sse

# 3. Server Configuration
PORT=4000
NODE_ENV=development

# 4. RAG Embedding Model (BAAI/bge-small-en-v1.5)
# NOTE: BAAI/bge-small-en-v1.5 is OPEN-SOURCE and runs locally via @xenova/transformers or Ollama.
# NO API KEY IS REQUIRED for local embedding execution!
# Optional (Only if using Hugging Face Cloud Inference API instead of local execution):
# HUGGINGFACE_API_KEY=your_hf_api_key_here
